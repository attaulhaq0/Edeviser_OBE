{
  "info": {
    "name": "Edeviser – Agent ILO Tools",
    "description": "9 read-tool exercisers for the ILO capability additions in registry.ts (agent-orchestrator POST interface). Import into the Edeviser API collection as a new folder, or merge manually.\n\nAll requests:\n  POST {{base_url}}/functions/v1/agent-orchestrator\n  Authorization: Bearer {{access_token}}\n  apikey: {{anon_key}}\n\nThe agent internally calls the registered read tool based on the message + context object. These requests are proof-of-exercise tests, not direct tool invocations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "edeviser-ilo-tools-v1"
  },
  "item": [
    {
      "name": "Agent – ILO Tools",
      "description": "Read-tool exercisers for the 9 ILO agent capabilities added in registry.ts.",
      "item": [
        {
          "name": "get_institution_ilos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anon_key}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"List all institution learning outcomes for this institution.\",\n  \"specialist\": \"institutional_outcomes\",\n  \"context\": {\n    \"route\": \"/admin/outcomes/ilos\"\n  },\n  \"requestId\": \"{{$guid}}\",\n  \"sessionId\": \"{{$guid}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/functions/v1/agent-orchestrator",
              "host": ["{{base_url}}"],
              "path": ["functions", "v1", "agent-orchestrator"]
            },
            "description": "Exercises `get_institution_ilos` — lists ILOs with mapping counts. Allowed role: admin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 10000ms', () => pm.expect(pm.response.responseTime).to.be.below(10000));",
                  "const body = pm.response.json();",
                  "pm.test('Has reply or error', () => {",
                  "  pm.expect(body).to.satisfy(b => b.reply !== undefined || b.error !== undefined);",
                  "});",
                  "pm.test('No unexpected 5xx error', () => {",
                  "  if (body.error) {",
                  "    pm.expect(body.error.code).to.not.equal('execution_failed');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
