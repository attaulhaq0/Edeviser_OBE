  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// FAIL-CLOSED ENVIRONMENT GUARD - do not remove.",
          "// This collection may ONLY run against a Supabase Preview (or local) target.",
          "// Production and malformed targets are rejected before any request is sent.",
          "const rawUrl = (pm.variables.get(\"base_url\") || \"\").trim();",
          "const declaredRef = (pm.variables.get(\"supabase_project_ref\") || \"\").trim();",
          "const productionRef = (pm.variables.get(\"production_project_ref\") || \"\").trim();",
          "if (!rawUrl) {",
          "  throw new Error(\"GUARD: base_url is not set. Select the Edeviser Preview environment and fill in the Git-linked Preview URL.\");",
          "}",
          "let parsed;",
          "try { parsed = new URL(rawUrl); } catch (_) {",
          "  throw new Error(\"GUARD: base_url is not a valid URL: \" + rawUrl);",
          "}",
          "const isLocal = parsed.hostname === \"localhost\" || parsed.hostname === \"127.0.0.1\" || parsed.hostname === \"[::1]\";",
          "if (!isLocal && parsed.protocol !== \"https:\") {",
          "  throw new Error(\"GUARD: non-local targets must use HTTPS: \" + rawUrl);",
          "}",
          "const supabaseHostRe = /^([a-z0-9]{20})\\.(supabase\\.co|supabase\\.red)$/;",
          "const hostMatch = supabaseHostRe.exec(parsed.hostname);",
          "if (!isLocal && !hostMatch) {",
          "  throw new Error(\"GUARD: base_url must be an exact Supabase project host or localhost: \" + parsed.hostname);",
          "}",
          "const derivedRef = hostMatch ? hostMatch[1] : \"\";",
          "const refsToCheck = [declaredRef, derivedRef].filter(Boolean);",
          "for (const ref of refsToCheck) {",
          "  if (productionRef && ref === productionRef) {",
          "    throw new Error(\"GUARD: production project ref rejected: \" + ref);",
          "  }",
          "}",
          "if (/prod/i.test(rawUrl) || refsToCheck.some(function (ref) { return /prod/i.test(ref); })) {",
          "  throw new Error(\"GUARD: production-looking target rejected: \" + rawUrl);",
          "}",
          "console.log(\"GUARD: preview target accepted:\", rawUrl);"
        ]
      }
    }
  ]
}
