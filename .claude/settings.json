{
  "//": "Committed Claude Code permissions for Edeviser. Safe read/build/test commands are pre-approved to reduce interruptions. Personal overrides go in settings.local.json (uncommitted).",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(npm run lint*)",
