{
  "$schema": "https://edeviser.dev/design-system-rules.schema.json",
  "version": "2026-09-10",
  "description": "Machine-readable design system rules for automated compliance checking",
  "rules": {
    "iconWrapper": {
      "description": "Icon containers in section/card headers",
      "decorative": {
        "allowedBackgrounds": ["bg-transparent", "bg-white/80"],
        "disallowedBackgrounds": [
          "bg-blue-50", "bg-green-50", "bg-yellow-50", "bg-red-50",
          "bg-purple-50", "bg-indigo-50", "bg-orange-50", "bg-teal-50",
          "bg-pink-50", "bg-rose-50", "bg-amber-50", "bg-emerald-50",
          "bg-cyan-50", "bg-sky-50", "bg-violet-50", "bg-fuchsia-50",
          "bg-lime-50",
          "bg-blue-100", "bg-green-100", "bg-yellow-100", "bg-red-100",
          "bg-purple-100", "bg-indigo-100", "bg-orange-100", "bg-teal-100",
          "bg-pink-100", "bg-rose-100", "bg-amber-100", "bg-emerald-100",
          "bg-cyan-100", "bg-sky-100", "bg-violet-100", "bg-fuchsia-100",
          "bg-lime-100"
        ]
      },
      "exceptions": {
        "semanticStatus": "Allowed for SeverityIcon, health badges, attainment badges",
        "gamification": "Allowed for XP chips, league tier badges, streak displays",
        "dataVisualization": "Allowed for Bloom's dots, progress bars, chart elements",
        "brandAccent": "Allowed for var(--brand-gradient) accent chips",
        "sidebarCompanion": "Allowed for AI Companion gradient badge",
        "interactiveHover": "Allowed for action button hover states (hover:bg-*-50)"
      }
    },
    "brandGradient": {
      "description": "Brand gradient usage rules",
      "canonicalSource": "var(--brand-gradient) = linear-gradient(93.65deg, #14B8A6 5.37%, #0382BD 78.89%)",
      "allowedUsage": [
        "GradientCardHeader component",
        "Button variant='tactile'",
        "Brand accent chips (max 1 per page)",
        "Logo/branding elements"
      ],
      "disallowedPatterns": [
        "from-teal-500 to-blue-600",
        "bg-gradient-to-r from-teal-500 to-blue-600",
        "Raw inline gradient on card headers outside GradientCardHeader"
      ]
    },
    "cssProperties": {
      "description": "CSS property direction rules",
      "required": ["ms-*", "me-*", "ps-*", "pe-*"],
      "disallowed": ["ml-*", "mr-*", "pl-*", "pr-*"],
      "exception": "Third-party library internals not under our control"
    },
    "semanticColors": {
      "description": "Allowed semantic color usages",
      "attainment": {
        "excellent": "bg-green-50 text-green-800 border-green-200",
        "satisfactory": "bg-blue-50 text-blue-700 border-blue-200",
        "developing": "bg-yellow-50 text-yellow-800 border-yellow-200",
        "notYet": "bg-red-50 text-red-700 border-red-200"
      },
      "bloomsTaxonomy": {
        "remembering": "bg-purple-100 text-purple-700",
        "understanding": "bg-blue-100 text-blue-700",
        "applying": "bg-green-100 text-green-700",
        "analyzing": "bg-yellow-100 text-yellow-700",
        "evaluating": "bg-orange-100 text-orange-700",
        "creating": "bg-red-100 text-red-700"
      },
      "outcomeTypes": {
        "ilo": "bg-red-100 text-red-700 border-red-200",
        "plo": "bg-blue-100 text-blue-700 border-blue-200",
        "clo": "bg-green-100 text-green-700 border-green-200"
      },
      "gamification": {
        "bronze": "bg-amber-600 text-white",
        "silver": "bg-gray-400 text-white",
        "gold": "bg-yellow-400 text-yellow-900",
        "diamond": "bg-blue-400 text-white"
      },
      "aiGovernance": {
        "a0a1": "border-blue-200 bg-blue-50 text-blue-700",
        "a2": "border-amber-200 bg-amber-50 text-amber-700",
        "a3": "border-emerald-200 bg-emerald-50 text-emerald-700"
      },
      "feedbackStates": {
        "success": "border-emerald-200 bg-emerald-50 text-emerald-800",
        "warning": "bg-amber-50 border border-amber-200"
      }
    },
    "componentUsage": {
      "description": "Component selection rules",
      "mustUse": {
        "gradientHeader": "GradientCardHeader from @/design-system",
        "sectionTitle": "SectionHeader from @/design-system",
        "kpiCard": "KPICard from @/design-system",
        "masteryRing": "MasteryRing from @/design-system",
        "severityIcon": "SeverityIcon from @/design-system",
        "welcomeHero": "WelcomeHero from @/design-system",
        "pCard": "PCard from @/design-system",
        "button": "Button from @/design-system (variant='tactile' for gradient)",
        "shimmer": "Shimmer from @/design-system"
      },
      "neverUse": [
        "Raw <button> or <input> elements",
        "Full-page skeleton loaders",
        "Raw emoji as chrome (use Lucide per PARITY.md)"
      ]
    },
    "routeMapping": {
      "coordinatorAccreditation": {
        "routes": ["/coordinator/accreditation", "/coordinator/course-file"],
        "component": "CourseFileGenerator -> CoordinatorAccreditationNew",
        "prototypes": ["coordinator-accreditation.html", "coordinator-course-file.html"],
        "status": "resolved",
        "notes": "Redesigned component handles both accreditation readiness and course file generation"
      }
    }
  }
}