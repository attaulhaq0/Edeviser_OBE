# ============================================================
# Edeviser — Environment Variables
# Copy this file to .env.local and fill in the values.
# ============================================================

# --- Client-side (VITE_ prefix — exposed to browser) --------

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/publishable key (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sentry DSN for error monitoring (optional — omit to disable)
VITE_SENTRY_DSN=

# Demo-account password (local / staging ONLY). When set, the login page
# shows a "Quick Demo Access" panel that signs in with the seeded demo
# users. Leave empty in production so the panel is hidden and the literal
# never ships in the client bundle.
VITE_DEMO_PASSWORD=

# Coordinator AI insight Edge Function (optional; disabled by default).
# This is a public client-side feature flag, not a secret.
VITE_COORDINATOR_AI_INSIGHTS_ENABLED=false

# --- Server-side (Vercel env vars for cron API routes) ------

# Supabase project URL (same as VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key — NEVER expose to client
# (Settings → API → service_role secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for authenticating Vercel cron requests
CRON_SECRET=your-cron-secret

# Proactive intelligence is off until explicitly enabled. The background
# worker remains deterministic; these flags do not enable protected actions
# without an authorized approval.
AI_FEATURE_ENABLED=false
AI_PROACTIVE_AGENTS_ENABLED=false
AI_AUTO_LOW_RISK_ENABLED=false
AI_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRIMARY_MODEL=deepseek-v4-flash
DEEPSEEK_COMPLEX_MODEL=deepseek-v4-pro
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_TOOL_STEPS=4
AI_MAX_TOOL_CALLS=6
AI_MAX_AGENT_TRANSFERS=2
AI_DAILY_BUDGET_USD=0
EMBEDDING_PROVIDER=supabase_gte_small

# --- Edge Function secrets (set via `supabase secrets set`) --

# Resend API key for transactional email
# RESEND_API_KEY=re_xxxxxxxx
# Canonical transactional email configuration (never expose values to Vite)
# EMAIL_FROM=Edeviser <team@edeviser.com>
# EMAIL_REPLY_TO=team@edeviser.com
# APP_URL=https://app.edeviser.com
# EMAIL_MODE=disabled
# EMAIL_ALLOWLIST=
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx

# DeepSeek is the only text-generation provider. This secret is server-only.
# DEEPSEEK_API_KEY=your-deepseek-api-key

# --- Preview-only E2E fixtures -------------------------------
# Never enable against production. The Playwright global setup requires all
# four values plus SUPABASE_DB_ENV=preview before it can seed a database.
# E2E_FIXTURES_ENABLED=false
# SUPABASE_DB_ENV=preview
# PLAYWRIGHT_BASE_URL=http://localhost:5173

# --- CI / GitHub Actions secrets -------------------------

# Sentry release upload
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=edeviser

# Supabase CLI (for type generation in CI)
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
