{
  "mcpServers": {
    "supabase": {
      "url": "https://mcp.supabase.com/mcp",
      "disabled": false,
      "autoApprove": [
        "search_docs",
        "list_organizations",
        "get_organization",
        "list_projects",
        "get_project",
        "get_cost",
        "list_tables",
        "list_extensions",
        "list_migrations",
        "get_logs",
        "get_advisors",
        "get_project_url",
        "get_publishable_keys",
        "generate_typescript_types",
        "list_edge_functions",
        "get_edge_function",
        "list_branches"
      ]
    },
    "github": {
      "command": "github-mcp-server.exe",
      "args": [
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REDACTED_USE_ENV_GITHUB_PAT"
      },
      "disabled": false,
      "autoApprove": []
    },
    "vercel": {
      "url": "https://mcp.vercel.com/mcp",
      "disabled": true,
      "autoApprove": []
    }
  }
}
